PORT=5000
MONGO_URI=
JWT_SECRET=
NODE_ENV=development
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=
# Sentry error monitoring (backend). Get from Sentry: Settings > Projects > <project> > Client Keys (DSN).
SENTRY_DSN=
